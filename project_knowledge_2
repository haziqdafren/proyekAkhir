"""
Tahap ini melakukan:
- Deteksi outliers ekstrem pada revenue harian menggunakan IQR method
- Replace outliers dengan interpolation (rata-rata hari sebelum & sesudah)
- Re-agregasi data bulanan setelah cleaning
- Dokumentasi untuk BAB 3
"""

print("=" * 80)
print("🧹 DATA CLEANING - REVENUE OUTLIERS")
print("=" * 80)

# ===== DETEKSI OUTLIERS DAILY =====
print("\n⏳ Detecting outliers di data harian...\n")

# Backup data original
df_original = df.copy()

# Hitung IQR untuk revenue harian
Q1 = df['Revenue'].quantile(0.25)
Q3 = df['Revenue'].quantile(0.75)
IQR = Q3 - Q1
lower_bound = Q1 - 3 * IQR  # 3x IQR (lebih conservative)
upper_bound = Q3 + 3 * IQR

print(f"Daily Revenue Statistics:")
print(f"  Q1 (25%): Rp {Q1:,.0f}")
print(f"  Q3 (75%): Rp {Q3:,.0f}")
print(f"  IQR: Rp {IQR:,.0f}")
print(f"  Upper Bound (Q3 + 3*IQR): Rp {upper_bound:,.0f}")

# Identifikasi outliers
outliers_mask = (df['Revenue'] < lower_bound) | (df['Revenue'] > upper_bound)
outliers = df[outliers_mask].copy()

print(f"\n🔍 Outliers detected: {len(outliers)} hari")

if len(outliers) > 0:
    print("\n📋 Detail outliers:")
    print(outliers[['Tanggal', 'Revenue', 'Kamar_Terjual', 'Okupansi_Rate']].to_string(index=True))

# ===== CLEANING METHOD: INTERPOLATION =====
print("\n" + "=" * 80)
print("🔧 CLEANING METHOD: Interpolation")
print("=" * 80)

print("\nℹ️ Metode: Replace outlier dengan rata-rata hari sebelum & sesudah")
print("   Jika di awal/akhir dataset, gunakan median bulan tersebut\n")

# Sort by date untuk memastikan urutan benar
df = df.sort_values('Tanggal').reset_index(drop=True)

outliers_cleaned = []

for idx in outliers.index:
    old_value = df.loc[idx, 'Revenue']
    tanggal = df.loc[idx, 'Tanggal']
    tahun = df.loc[idx, 'Tahun']
    bulan = df.loc[idx, 'Bulan']
    
    # Method 1: Interpolation dari hari sebelum & sesudah
    if idx > 0 and idx < len(df) - 1:
        prev_value = df.loc[idx - 1, 'Revenue']
        next_value = df.loc[idx + 1, 'Revenue']
        
        # Check jika prev/next juga outlier, skip
        if prev_value > upper_bound or next_value > upper_bound:
            # Gunakan median bulan tersebut
            month_data = df[(df['Tahun'] == tahun) & (df['Bulan'] == bulan) & 
                           (df['Revenue'] <= upper_bound)]['Revenue']
            new_value = month_data.median()
            method = "median_bulan"
        else:
            new_value = (prev_value + next_value) / 2
            method = "interpolation"
    else:
        # Di awal/akhir dataset, gunakan median bulan
        month_data = df[(df['Tahun'] == tahun) & (df['Bulan'] == bulan) & 
                       (df['Revenue'] <= upper_bound)]['Revenue']
        new_value = month_data.median()
        method = "median_bulan"
    
    # Update value
    df.loc[idx, 'Revenue'] = new_value
    
    outliers_cleaned.append({
        'Tanggal': tanggal,
        'Old_Value': old_value,
        'New_Value': new_value,
        'Method': method,
        'Kamar_Terjual': df.loc[idx, 'Kamar_Terjual'],
        'Okupansi_Rate': df.loc[idx, 'Okupansi_Rate']
    })

# ===== REPORT CLEANING =====
if len(outliers_cleaned) > 0:
    print("✅ Cleaning completed!")
    print("\n📊 CLEANING REPORT:")
    df_cleaning = pd.DataFrame(outliers_cleaned)
    print(df_cleaning.to_string(index=False))
    
    print(f"\n💾 Total revenue cleaned:")
    print(f"   Before: Rp {df_cleaning['Old_Value'].sum():,.0f}")
    print(f"   After:  Rp {df_cleaning['New_Value'].sum():,.0f}")
    print(f"   Diff:   Rp {(df_cleaning['Old_Value'].sum() - df_cleaning['New_Value'].sum()):,.0f}")

# ===== VALIDASI AFTER CLEANING =====
print("\n" + "=" * 80)
print("✅ VALIDASI AFTER CLEANING")
print("=" * 80)

# Check outliers lagi
outliers_remaining = df[(df['Revenue'] < lower_bound) | (df['Revenue'] > upper_bound)]
print(f"\n🔍 Outliers remaining: {len(outliers_remaining)} hari")

if len(outliers_remaining) == 0:
    print("✅ All outliers successfully cleaned!")
else:
    print("⚠️ Warning: Some outliers remain")
    print(outliers_remaining[['Tanggal', 'Revenue']])

# ===== STATISTICS COMPARISON =====
print("\n" + "=" * 80)
print("📊 STATISTICS COMPARISON (Daily Revenue)")
print("=" * 80)

stats_comparison = pd.DataFrame({
    'Metric': ['Mean', 'Median', 'Std', 'Min', 'Max'],
    'Before_Cleaning': [
        df_original['Revenue'].mean(),
        df_original['Revenue'].median(),
        df_original['Revenue'].std(),
        df_original['Revenue'].min(),
        df_original['Revenue'].max()
    ],
    'After_Cleaning': [
        df['Revenue'].mean(),
        df['Revenue'].median(),
        df['Revenue'].std(),
        df['Revenue'].min(),
        df['Revenue'].max()
    ]
})

print("\n", stats_comparison.to_string(index=False))

print("\n" + "=" * 80)
print("✅ DATA CLEANING COMPLETE!")
