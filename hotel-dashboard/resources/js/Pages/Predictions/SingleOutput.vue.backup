<template>
  <DashboardLayout>
    <div class="p-8 space-y-8 max-w-[1400px] mx-auto">
      <!-- Header -->
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-3xl font-bold text-primary-dark">Prediksi Total Okupansi</h1>
          <p class="text-gray-500 mt-2">Model LSTM Single-Output - Prediksi okupansi keseluruhan hotel</p>
        </div>
        <Link href="/predictions" class="px-5 py-2.5 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-2xl font-medium transition-colors">
          ← Kembali
        </Link>
      </div>

      <!-- Model Explanation Card -->
      <ModelExplanationCard
        title="📊 Model Single-Output LSTM"
        description="Model ini memprediksi TOTAL okupansi hotel secara keseluruhan (gabungan semua tipe kamar). Menggunakan data 6 bulan terakhir untuk memprediksi okupansi bulanan."
        :advantages="[
          'Akurasi tinggi (MAPE 21.28% - terbaik!)',
          'Memberikan gambaran okupansi keseluruhan hotel',
          'Cocok untuk perencanaan tingkat manajemen',
          'Lebih stabil dan konsisten',
          'Bagus untuk forecast revenue total'
        ]"
        :limitations="[
          'Tidak memberikan detail per tipe kamar',
          'Kurang cocok untuk strategi pricing per room',
          'Tidak bisa lihat performa individual kamar',
          'Terlalu general untuk marketing spesifik'
        ]"
        :use-cases="[
          'Perencanaan jumlah staff operasional',
          'Laporan bulanan untuk manajemen',
          'Forecast revenue dan budget planning',
          'Evaluasi performa hotel secara umum',
          'Perencanaan inventory dan supplies'
        ]"
        :mape="21.28"
        :is-recommended="true"
      />

      <!-- Generate Prediction Form -->
      <div class="bg-white rounded-3xl shadow-sm border border-surface/30 p-8">
        <h2 class="text-xl font-semibold text-primary-dark mb-6">Generate Prediksi Baru</h2>
        
        <form @submit.prevent="generatePrediction" class="space-y-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Pilih Bulan untuk Prediksi</label>
            <input
              v-model="selectedMonth"
              type="month"
              :min="minMonth"
              class="w-full md:w-96 px-4 py-3 border border-surface rounded-2xl focus:outline-none focus:ring-2 focus:ring-primary/30 transition-all"
              required
            />
            <p class="text-xs text-gray-500 mt-2">Akan menggunakan 6 bulan data terakhir untuk prediksi</p>

            <!-- Warning if month already has prediction -->
            <div v-if="monthAlreadyPredicted" class="mt-3 flex items-start gap-2 p-3 bg-yellow-50 border border-yellow-200 rounded-xl">
              <svg class="w-5 h-5 text-yellow-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <div class="flex-1">
                <p class="text-sm font-medium text-yellow-800">Prediksi sudah ada untuk bulan ini</p>
                <p class="text-xs text-yellow-700 mt-1">Membuat prediksi baru akan <strong>memperbarui</strong> prediksi yang sudah ada dengan nilai terbaru</p>
              </div>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <button
              type="submit"
              :disabled="generating"
              :class="monthAlreadyPredicted ? 'bg-yellow-600 hover:bg-yellow-700' : 'bg-primary hover:bg-primary-dark'"
              class="px-6 py-3 text-white rounded-2xl font-semibold transition-all disabled:opacity-50 disabled:cursor-not-allowed flex items-center gap-2"
            >
              <svg v-if="!generating" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
              <svg v-else class="w-5 h-5 animate-spin" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              {{ generating ? 'Generating...' : (monthAlreadyPredicted ? 'Perbarui Prediksi' : 'Generate Prediksi') }}
            </button>

            <p v-if="$page.props.flash?.success" class="text-green-600 font-medium">
              ✓ {{ $page.props.flash.success }}
            </p>
            <p v-if="$page.props.errors?.error" class="text-red-600 font-medium">
              ✗ {{ $page.props.errors.error }}
            </p>
          </div>
        </form>
      </div>

      <!-- Recent Predictions -->
      <div v-if="recentPredictions.length > 0" class="bg-white rounded-3xl shadow-sm border border-surface/30 overflow-hidden">
        <div class="px-8 py-6 border-b border-surface/30">
          <h2 class="text-xl font-semibold text-primary-dark">Prediksi Terbaru</h2>
          <p class="text-sm text-gray-500 mt-1">Hasil prediksi yang telah dibuat</p>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-8 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Bulan</th>
                <th class="px-8 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Okupansi</th>
                <th class="px-8 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Confidence</th>
                <th class="px-8 py-4 text-left text-xs font-semibold text-gray-600 uppercase tracking-wider">Dibuat</th>
                <th class="px-8 py-4 text-center text-xs font-semibold text-gray-600 uppercase tracking-wider">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
              <tr v-for="prediction in recentPredictions" :key="prediction.id" class="hover:bg-gray-50 transition-colors">
                <td class="px-8 py-4">
                  <span class="font-semibold text-primary-dark">{{ formatMonth(prediction.predicted_for_date) }}</span>
                </td>
                <td class="px-8 py-4">
                  <div class="flex items-center gap-3">
                    <div class="flex-1">
                      <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold text-primary-dark">{{ Number(prediction.predicted_occupancy_rate || 0).toFixed(1) }}%</span>
                        <span class="text-sm text-gray-500">(~{{ calculateRooms(prediction.predicted_occupancy_rate) }} kamar)</span>
                      </div>
                      <div class="w-full bg-gray-200 rounded-full h-2 mt-2">
                        <div
                          class="bg-primary h-2 rounded-full transition-all"
                          :style="{ width: `${prediction.predicted_occupancy_rate}%` }"
                        ></div>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="px-8 py-4">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold"
                    :class="getConfidenceClass(prediction.confidence_level)">
                    {{ Number(prediction.confidence_level || 0).toFixed(1) }}%
                  </span>
                </td>
                <td class="px-8 py-4 text-sm text-gray-500">
                  {{ formatDate(prediction.created_at) }}
                </td>
                <td class="px-8 py-4 text-center">
                  <button
                    @click="confirmDelete(prediction)"
                    class="inline-flex items-center px-3 py-2 text-sm font-medium text-red-600 hover:text-red-700 hover:bg-red-50 rounded-xl transition-colors"
                  >
                    <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    Hapus
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Empty State -->
      <div v-else class="bg-white rounded-3xl shadow-sm border border-surface/30 p-12 text-center">
        <div class="max-w-md mx-auto">
          <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-lg font-semibold text-gray-900 mb-2">Belum Ada Prediksi</h3>
          <p class="text-gray-500">Mulai dengan membuat prediksi pertama Anda menggunakan form di atas</p>
        </div>
      </div>
    </div>

    <!-- Loading Modal -->
    <LoadingModal
      :show="generating"
      title="Generating Prediction"
      message="Model LSTM sedang menganalisis data historis dan membuat prediksi okupansi..."
    />

    <!-- Delete Confirmation Modal -->
    <ConfirmModal
      :show="showDeleteConfirm"
      title="Hapus Prediksi?"
      :message="`Apakah Anda yakin ingin menghapus prediksi untuk ${predictionToDelete?.monthName}? Tindakan ini tidak dapat dibatalkan.`"
      confirm-text="Ya, Hapus"
      cancel-text="Batal"
      type="danger"
      @confirm="deletePrediction"
      @close="showDeleteConfirm = false"
    />
  </DashboardLayout>
</template>

<script setup>
import { ref, computed } from 'vue';
import { router, Link } from '@inertiajs/vue3';
import DashboardLayout from '@/Layouts/DashboardLayout.vue';
import LoadingModal from '@/Components/LoadingModal.vue';
import ConfirmModal from '@/Components/ConfirmModal.vue';
import ModelExplanationCard from '@/Components/ModelExplanationCard.vue';
import PredictionInsightCard from '@/Components/PredictionInsightCard.vue';
import MonthComparisonCard from '@/Components/MonthComparisonCard.vue';

const props = defineProps({
  recentPredictions: Array,
  comparisons: Array,
  totalRooms: Number,
  modelInfo: Object,
  roomTypes: Array,
});

const selectedMonth = ref('');
const generating = ref(false);
const showDeleteConfirm = ref(false);
const predictionToDelete = ref(null);

// Set minimum month to next month
const minMonth = computed(() => {
  const nextMonth = new Date();
  nextMonth.setMonth(nextMonth.getMonth() + 1);
  return nextMonth.toISOString().slice(0, 7);
});

// Check if selected month already has a prediction
const monthAlreadyPredicted = computed(() => {
  if (!selectedMonth.value || !props.recentPredictions) return false;

  return props.recentPredictions.some(pred => {
    const predDate = new Date(pred.predicted_for_date);
    const selectedDate = new Date(selectedMonth.value + '-01');
    return predDate.getFullYear() === selectedDate.getFullYear() &&
           predDate.getMonth() === selectedDate.getMonth();
  });
});

const generatePrediction = () => {
  if (!selectedMonth.value) return;

  generating.value = true;

  router.post('/predictions/generate-single', {
    predict_for_month: selectedMonth.value + '-01',
  }, {
    preserveScroll: true,
    onFinish: () => {
      generating.value = false;
    },
  });
};

const confirmDelete = (prediction) => {
  const predDate = new Date(prediction.predicted_for_date);
  predictionToDelete.value = {
    id: prediction.id,
    year: predDate.getFullYear(),
    month: predDate.getMonth() + 1,
    monthName: formatMonth(prediction.predicted_for_date),
  };
  showDeleteConfirm.value = true;
};

const deletePrediction = () => {
  if (!predictionToDelete.value) return;

  router.delete(`/predictions/month/${predictionToDelete.value.year}/${predictionToDelete.value.month}/single`, {
    preserveScroll: true,
    onSuccess: () => {
      showDeleteConfirm.value = false;
      predictionToDelete.value = null;
    },
  });
};

const formatMonth = (dateString) => {
  return new Date(dateString).toLocaleDateString('id-ID', {
    month: 'long',
    year: 'numeric',
  });
};

const formatDate = (dateString) => {
  return new Date(dateString).toLocaleDateString('id-ID', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
  });
};

const calculateRooms = (occupancyRate) => {
  return Math.round((occupancyRate / 100) * 58);
};

const getConfidenceClass = (confidence) => {
  if (confidence >= 75) return 'bg-green-100 text-green-700';
  if (confidence >= 60) return 'bg-yellow-100 text-yellow-700';
  return 'bg-red-100 text-red-700';
};
</script>
